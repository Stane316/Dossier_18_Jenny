# JENNY EXPERIENCE — Browser environment
# Copy this file to .env and fill in public client configuration only.
# Never commit .env. A Supabase service_role key must never be exposed to Vite.

# Supabase — dedicated Jenny project
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional — contributor sharing base URL
VITE_SITE_URL=https://jenny-experience.netlify.app

# Browser environment
VITE_APP_ENV=production

# Private Jenny access is configured only as Supabase Edge Function secrets.
# Do not prefix these names with VITE_ and do not place their values in this file:
# JENNY_ACCESS_CODE          strong private code (at least 24 characters)
# JENNY_SESSION_SECRET       independent random signing key (at least 32 characters)
# JENNY_ALLOWED_ORIGINS      comma-separated exact origins, without a trailing slash
# JENNY_SESSION_TTL_SECONDS  optional; 300–14400, capped server-side at 4 hours
