# JENNY EXPERIENCE — Environment
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne JAMAIS committer .env (gitignore). Les clés service_role ne doivent jamais aller côté client.

# Supabase — projet dédié Jenny (https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Token privé Jenny — protège /jenny et /jenny/* 
