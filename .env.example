# PUBLIC VITE VARIABLES — configure these in Netlify for production.
# Values prefixed VITE_ are embedded in the browser bundle; never put a server
# secret or service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead of the publishable key.
# VITE_SUPABASE_ANON_KEY=eyJ_REPLACE_ME
VITE_SITE_URL=https://dossier-jenny18ans.netlify.app
VITE_APP_ENV=production

# TEMPORARY JENNY CLIENT GATE — configure these in Netlify for the birthday
# version. Despite lacking the VITE_ prefix, vite.config.ts explicitly embeds
# both values in the browser bundle. They are recoverable by visitors and are
# therefore NOT production authentication. Never reuse a sensitive password.
EMAIL_JENNY=jenny@example.com
PASSWORD_JENNY=replace-with-a-temporary-unique-password
# Shared with Supabase Edge Function secret JENNY_DATA_TOKEN. This bearer value
# is also embedded in the browser bundle and must be treated as temporary.
JENNY_DATA_TOKEN=replace-with-a-random-value-of-at-least-32-characters

# EDGE FUNCTION VARIABLES — configure these in Supabase Dashboard.
# They are documented here by name; do not place their real values in Netlify,
# a local committed .env file, or the browser bundle.
#
# JENNY_DATA_TOKEN             exact same temporary 32+ character value as Netlify
# SITE_ALLOWED_ORIGINS         https://dossier-jenny18ans.netlify.app
# CONTRIBUTION_RATE_LIMIT_SECRET  random server-only secret of at least 32 characters
#
# SUPABASE_URL and the project server key are supplied to Edge Functions by
# Supabase. The source prefers Supabase's SUPABASE_SECRET_KEYS JSON `default`
# value and falls back to SUPABASE_SERVICE_ROLE_KEY; neither is public.
